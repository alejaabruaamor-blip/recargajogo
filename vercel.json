{
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/backend.php",
      "destination": "/api/backend"
    },
    {
      "source": "/(.*)/backend.php",
      "destination": "/api/backend"
    },
    {
      "source": "/check_status.php",
      "destination": "/api/check_status"
    },
    {
      "source": "/(.*)/check_status.php",
      "destination": "/api/check_status"
    }
  ],
  "redirects": [
    {
      "source": "/pix.html",
      "destination": "/ebookdesign/",
      "permanent": false
    },
    {
      "source": "/loja/checkout.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/loja/checkout",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/rec/erro/pagamento",
      "destination": "/rec/up2/",
      "permanent": false
    },
    {
      "source": "/rec/erro/pagamento/",
      "destination": "/rec/up2/",
      "permanent": false
    },
    {
      "source": "/resgate/skins",
      "destination": "/rec/up3/",
      "permanent": false
    },
    {
      "source": "/resgate/skins/",
      "destination": "/rec/up3/",
      "permanent": false
    },
    {
      "source": "/ebookdesign/iof/index.html",
      "destination": "/rec/up1/",
      "permanent": false
    },
    {
      "source": "/ebookdesign/iof",
      "destination": "/rec/up1/",
      "permanent": false
    },
    {
      "source": "/apipix",
      "destination": "/ebookdesign/",
      "permanent": false
    },
    {
      "source": "/apipix/:path*",
      "destination": "/ebookdesign/:path*",
      "permanent": false
    }
  ]
}
